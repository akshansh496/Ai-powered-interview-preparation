# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database Configuration
MONGO_URI=mongodb://localhost:27017/interview-prep

# Authentication
JWT_SECRET=your-jwt-secret-key

# ── AI Provider Credentials ────────────────────────────────────────────────
# One API key per provider. Do NOT add per-model API keys.

# Google Gemini
GOOGLE_GENAI_API_KEY=your-gemini-api-key

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key

# ── Verified Model Configuration ───────────────────────────────────────────
# Set these ONLY after running: node Backend/scripts/verify-ai-models.js
# Do NOT guess model IDs. Unverified model IDs will be ignored by the router.
#
# Gemini models (priority 1 and 2 in dynamic routing)
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_SECONDARY_MODEL=gemini-3.1-flash-lite

# OpenRouter free models (priority 3 and 4 in dynamic routing)
# Only set OPENROUTER_PRIMARY_MODEL and OPENROUTER_SECONDARY_MODEL to verified models.
# Leave blank if no verified OpenRouter model is available.
OPENROUTER_PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_SECONDARY_MODEL=<verified-model-id>:free

# Final availability fallback — always keep as openrouter/free. Do not change.
OPENROUTER_MODEL=openrouter/free

# ── AI Gateway Configuration ────────────────────────────────────────────────
AI_ENABLE_FALLBACK=true
AI_PROVIDER_TIMEOUT_MS=8000
AI_MODEL_FAILURE_THRESHOLD=3
AI_MODEL_COOLDOWN_MS=300000
AI_MAX_RETRIES=0

# Rate Limiter Configuration
AI_REQUEST_LIMIT_PER_WINDOW=10
AI_RATE_LIMIT_WINDOW_MS=900000
